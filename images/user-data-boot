#!/bin/sh
# Fetches SandboxConfig.user_data.boot from the runtime's own sandbox
# metadata endpoint and executes it, if present.

MMDS_ADDR=169.254.169.254
LOG=/var/log/user-data-boot.log
BOOT_SCRIPT=/tmp/user-data-boot.sh
TIMEOUT=1

mkdir -p "$(dirname "$LOG")"
exec >"$LOG" 2>&1

echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) fetching user data from ${MMDS_ADDR}"

TOKEN=$(curl -s -m "$TIMEOUT" -X PUT "http://${MMDS_ADDR}/latest/api/token" \
	-H "X-metadata-token-ttl-seconds: 21600")
if [ -z "$TOKEN" ]; then
	echo "no mmds token -- sandbox has no metadata endpoint route or none was requested, skipping"
	exit 0
fi

BOOT=$(curl -s -m "$TIMEOUT" -H "X-metadata-token: $TOKEN" "http://${MMDS_ADDR}/boot")
if [ -z "$BOOT" ]; then
	echo "no boot user data set, skipping"
	exit 0
fi

printf '%s' "$BOOT" >"$BOOT_SCRIPT"
chmod +x "$BOOT_SCRIPT"

echo "running boot user data:"
echo "----"
cat "$BOOT_SCRIPT"
echo "----"
"$BOOT_SCRIPT"
echo "boot user data exited with status $?"
rm -f "$BOOT_SCRIPT"
