# Alpine's own official minirootfs (https://alpinelinux.org/downloads/),
# made "complete" with OpenRC and sandboxd as an enabled service.
# ROOTFS_TARBALL is downloaded by the Makefile before this builds.
ARG ROOTFS_TARBALL=alpine-minirootfs.tar.gz

FROM registry.k8s.io/agent-sandbox/sandboxd:v1.0.10 AS sandboxd

FROM scratch
ARG ROOTFS_TARBALL
ADD ${ROOTFS_TARBALL} /

# openrc's post-install rewrites /etc/inittab to boot its own
# runlevels. pivot_root is already a busybox applet here. curl is for
# images/user-data-boot.
RUN apk add --no-cache openrc bash sudo shadow curl

# Stock inittab only gettys on vt consoles, which don't exist under
# Firecracker -- enable the commented-out serial console entry.
RUN sed -i 's/^#ttyS0/ttyS0/' /etc/inittab

# Passwordless but NOPASSWD sudo -- see Dockerfile.ubuntu-systemd.
RUN useradd -m -s /bin/bash sandbox \
    && passwd -d sandbox \
    && echo 'sandbox ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/sandbox

COPY --from=sandboxd /usr/local/bin/sandboxd /usr/local/bin/sandboxd
COPY sandboxd.openrc /etc/init.d/sandboxd
RUN chmod +x /etc/init.d/sandboxd && rc-update add sandboxd default

COPY --chmod=755 init /init
COPY --chmod=755 user-data-boot /usr/local/sbin/user-data-boot
