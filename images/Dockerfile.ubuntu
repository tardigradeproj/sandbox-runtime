FROM registry.k8s.io/agent-sandbox/sandboxd:v1.0.10 AS sandboxd

FROM ubuntu:24.04

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
      ubuntu-standard \
      curl wget iproute2 netcat-openbsd python3 \
      dbus systemd openssh-server net-tools iputils-ping vim-tiny sudo && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY --from=sandboxd /usr/local/bin/sandboxd /usr/local/bin/sandboxd
COPY --chmod=755 init /init

